{
  "name": "Sivander's Recept",
  "short_name": "Recept",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#e8e6e1",
  "theme_color": "#15191a",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "id": "/",
  "scope": "/",
  "description": "Nicklas och Ann-Sofies receptbok",
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}